# Copy to .env and fill in. .env is gitignored.

# Honeycomb ingest API key (Environment settings > API keys).
HONEYCOMB_API_KEY=

# Optional. Defaults shown.
# EU accounts use api.eu1.honeycomb.io:443.
# HONEYCOMB_API_ENDPOINT=api.honeycomb.io:443
# Honeycomb dataset for metrics (traces and logs go to one dataset per service).
# HONEYCOMB_METRICS_DATASET=otel-play-metrics
